{
    "rewrites": [
        { "source": "/api/ngg", "destination": "/api/ngg" },
        { "source": "/api/cron/:match*", "destination": "/api/cron/:match*" },
        { "source": "/api/(.*)", "destination": "/api/index" },
        { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
    ],
    "crons": [
        {
        "path": "/api/cron/snapshot",
        "schedule": "0 0 * * *"
        }
    ]
}